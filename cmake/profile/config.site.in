# Autoconf site defaults for the @PROFILE@ toolchain profile of mpv-winbuild,
# read by configure scripts run through the exec wrapper. Arguments of a recipe
# still take precedence.

# Absolute paths: llvm-windres finds its preprocessor next to the path it was
# started from.
: "${CC=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang}"
: "${CXX=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang++}"
: "${RC=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-windres}"
: "${WINDRES=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-windres}"
