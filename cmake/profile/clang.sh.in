#!/bin/sh
# clang finds configuration files only in its own directories, so the profile's
# is passed with --config. ccache does not read --config, so it hashes the file.
export CCACHE_DIR="@CCACHE_DIR@"
export CCACHE_EXTRAFILES="@CLANG_CONFIG_FILE@"
exec "@CCACHE_EXECUTABLE@" "@DRIVER@" --config="@CLANG_CONFIG_FILE@" "$@"
