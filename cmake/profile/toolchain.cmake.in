# CMake toolchain file for the @PROFILE@ toolchain profile of mpv-winbuild.

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR @TARGET_PROCESSOR@)

set(CMAKE_C_COMPILER "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang")
set(CMAKE_CXX_COMPILER "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang++")
set(CMAKE_RC_COMPILER "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-windres")

# Archivers for interprocedural optimization. llvm-ar reads LLVM bitcode
# objects without a plugin.
set(CMAKE_C_COMPILER_AR "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-ar")
set(CMAKE_CXX_COMPILER_AR "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-ar")
set(CMAKE_C_COMPILER_RANLIB "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-ranlib")
set(CMAKE_CXX_COMPILER_RANLIB "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-ranlib")

# No package uses C++ modules, and clang-scan-deps would not see the options
# the compiler wrapper adds.
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

set(CMAKE_FIND_ROOT_PATH "@SYSROOT_DIR@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(PKG_CONFIG_EXECUTABLE "@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-pkg-config")
