# clang configuration of the @PROFILE@ toolchain profile. Options prefixed with
# $ apply only to links, after the linker inputs.

--target=@TARGET_TRIPLE@
--sysroot=@SYSROOT_DIR@
-resource-dir=@CLANG_RESOURCE_DIR@
-rtlib=compiler-rt
-unwindlib=libunwind
-stdlib=libc++
-fuse-ld=lld

@CPU_FLAGS@
-mguard=cf
-ffunction-sections
-fdata-sections

$-static
$-Wl,-s
$-Wl,--lto-O3
$-Wl,--gc-sections
$-Wl,--icf=safe
$-Wl,-Xlink=-release
$-Wl,--thinlto-jobs=all
$-Wl,--thinlto-cache-dir=@THINLTO_CACHE_DIR@
$-Wl,--thinlto-cache-policy=cache_size_bytes=1g:prune_interval=1m
